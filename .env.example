# Copy to .env (git-ignored) and fill in.

# XRPL node — mainnet / testnet / devnet.
#   wss://xrplcluster.com                 (mainnet)
#   wss://s.altnet.rippletest.net:51233   (testnet)
#   wss://s.devnet.rippletest.net:51233   (devnet)
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# Treasury wallet secret (seed).  Signs the Batch outer tx.
# Use a TEST wallet when learning — this seed can drain the account.
TREASURY_SEED=sEdXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Recipient of the sell-offer (the NFT buyer / claimant).
BUYER_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Metadata URI stored in NFTokenMint.  Keep ≤ 256 bytes.
NFT_URI=https://example.com/metadata/sample-nft.json

# Enable the Batch path.  Set false to force the sequential fallback.
USE_BATCH_MINT=true
